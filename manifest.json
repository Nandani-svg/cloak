{
"manifest_version": 3,
"name": "Cloak",
"version": "2.0.0",
"description": "Easily manage website permissions and tracking",
"action": {
 "default_icon": {
       "16": "images/logo16.png",
       "32": "images/logo32.png",
       "48": "images/logo48.png",
       "128": "images/logo128.png"
     },
     "default_title": "Cloak for chrome",
     "default_popup": "menu.html"
},
"permissions": [
"browsingData",
"contentSettings",
"activeTab"
]
}